# ── Contact form email (temporary Gmail App Password) ──────────
# 1. Enable 2-Step Verification on the Gmail account
# 2. Create an App Password: Google Account → Security → App passwords
# 3. Paste the 16-character App Password into SMTP_PASSWORD (spaces optional)
# CONTACT_EMAIL = inbox(es) for enquiries — comma-separated for multiple recipients
# SMTP_USER     = Gmail account used to send (must match App Password owner)
CONTACT_EMAIL=info@orionmetalindustries.com.au,anandanathurelangovan94@gmail.com,orionmetalindustries@gmail.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.sender@gmail.com
SMTP_PASSWORD=xxxx xxxx xxxx xxxx

# Optional aliases (same as SMTP_USER / SMTP_PASSWORD)
# GMAIL_USER=
# GMAIL_APP_PASSWORD=

NEXT_PUBLIC_SITE_URL=https://orionmetalindustries.com.au

# Supabase (required for dynamic products, blog, reviews, customers)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional — for future CMS admin writes (keep secret, server-only)
SUPABASE_SERVICE_ROLE_KEY=

# Optional — Google Business Profile URL (for "View on Google" / review links)
NEXT_PUBLIC_GOOGLE_BUSINESS_URL=
